# Set on the selected Convex deployment, never as EXPO_PUBLIC_* values.
CLERK_JWT_ISSUER_DOMAIN=
OPENROUTER_API_KEY=
# Only openrouter/free or a model ID ending in :free is accepted.
# Default: Google Gemma 4 31B (free). Use openrouter/free to let OpenRouter choose.
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free
# Free model OpenRouter tries if the primary fails (rate limit, downtime).
# Set to "none" to disable. Default: NVIDIA Nemotron 3 Ultra (free).
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# "true" lets free providers log/train on prompts (Nemotron needs this). Demo
# only, with non-sensitive data. Anything else keeps data_collection=deny.
NEEM_AI_DATA_COLLECTION=false
NEEM_AI_DAILY_CALL_LIMIT=50
NEEM_AI_MONTHLY_CALL_LIMIT=1000
# Book embeddings are separate from free chat and disabled by default.
NEEM_AI_LIBRARY_ENABLED=false
NEEM_AI_BRIDGE_URL=https://neem-pressure-pulse.lovable.app/api/neem-gateway
NEEM_AI_BRIDGE_SECRET=
NEEM_ADMIN_CLERK_IDS=
NEEM_AI_REQUIRE_PREMIUM=false
# Free chat reserves zero micro-USD but still enforces call caps.
# Optional embeddings retain conservative reservations, not the provider bill.
# Setting either reserve limit to 0 stops all AI, including free chat.
NEEM_AI_DAILY_RESERVE_MICRO_USD=500000
NEEM_AI_MONTHLY_RESERVE_MICRO_USD=2000000
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=neem_premium
# Daily video: server-only key; disabled until the account is connected.
DAILY_API_KEY=
DAILY_VIDEO_ENABLED=false
# Conservative app-level reservation guard, capped at 9000 participant-minutes.
DAILY_MONTHLY_PARTICIPANT_MINUTES=9000
# Care administrators are verified Clerk user IDs, separate from library admins.
NEEM_CARE_ADMIN_CLERK_IDS=
# pawaPay tokens stay server-only. Live checkout must be explicitly enabled.
PAWAPAY_API_TOKEN=
PAWAPAY_ENVIRONMENT=production
PAWAPAY_CHECKOUT_ENABLED=false
