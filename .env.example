# Public values: bundled into the Expo app. Secret keys belong in the backend.
# Set OPENROUTER_API_KEY only on the Convex deployment; see convex/.env.example.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Exact, hardware-verified service and protocol values; leave blank until verified.
EXPO_PUBLIC_BLE_SERVICE_UUID=
EXPO_PUBLIC_BLE_PRESSURE_CHARACTERISTIC_UUID=
EXPO_PUBLIC_BLE_PROTOCOL=
# Optional public RevenueCat native SDK keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
